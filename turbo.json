{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "expo-dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "seed": {
      "cache": false
    },
    "@abonten/web#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "expo-dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/src/planning/planning-math.ts", "$TURBO_ROOT$/apps/api/src/planning/planning-enrichment.ts"]
    },
    "@abonten/web#test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/src/planning/planning-math.ts", "$TURBO_ROOT$/apps/api/src/planning/planning-enrichment.ts"]
    },
    "@abonten/web#type-check": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/src/planning/planning-math.ts", "$TURBO_ROOT$/apps/api/src/planning/planning-enrichment.ts"]
    },
    "@abonten/web#lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/src/planning/planning-math.ts", "$TURBO_ROOT$/apps/api/src/planning/planning-enrichment.ts"]
    }
  }
}
