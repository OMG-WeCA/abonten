# Nonsecret defaults and REQUIRED VALUE NAMES ONLY. Never fill/save this file
# with actual credentials. Provision approved values in Asiri instead.
ABONTEN_IMAGE_TAG=replace-with-reviewed-release-tag
ABONTEN_BIND_ADDRESS=127.0.0.1
ABONTEN_API_BIND_PORT=3302
ABONTEN_WEB_BIND_PORT=3303
API_BASE_URL=https://abonten.omgwca.com
WEB_BASE_URL=https://abonten.omgwca.com
NEXT_PUBLIC_API_BASE_URL=https://abonten.omgwca.com
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
JWT_SECRET=
SESSION_SECRET=
EMAIL_CODE_SECRET=
POSTGIS_IMAGE=postgis/postgis:16-3.4
POSTGRES_BOOTSTRAP_USER=abonten_admin
POSTGRES_BOOTSTRAP_PASSWORD=
# DATABASE_URL: postgresql://abonten_app:<encoded password>@postgres:5432/abonten
# This application/migration role is NOT the bootstrap superuser.
DATABASE_URL=
REDIS_IMAGE=redis:7-alpine
REDIS_PASSWORD=
# REDIS_URL: redis://:<encoded same REDIS_PASSWORD>@redis:6379/0
REDIS_URL=
# Local MinIO is optional. Select its approved immutable image before use.
MINIO_IMAGE=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# If local MinIO is selected, S3_ENDPOINT=http://minio:9000; otherwise approved
# managed S3 endpoint. The app serves assets through authenticated API routes.
S3_ENDPOINT=
S3_BUCKET=abonten-assets
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URL=
ENRICHMENT_DATA_DIR=/app/var/enrichment
