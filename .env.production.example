# Names and shapes only. Supply actual values from Asiri or ccp-prod secret
# injection; do not copy credentials into the repository.
ABONTEN_IMAGE_TAG=
ABONTEN_BIND_ADDRESS=127.0.0.1
ABONTEN_API_BIND_PORT=3000
ABONTEN_WEB_BIND_PORT=3001

# Public URLs. If the web app is served under a prefix, set it consistently.
API_BASE_URL=
WEB_BASE_URL=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# API signing and email-code keys (three distinct 32+ character secrets).
JWT_SECRET=
SESSION_SECRET=
EMAIL_CODE_SECRET=

# Existing managed services; do not use the development Compose services.
DATABASE_URL=
REDIS_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional Microsoft sign-in: supply the whole group if enabled.
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URL=
