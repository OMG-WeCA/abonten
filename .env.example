# ---- Abonten dev environment (copy to .env) ----
NODE_ENV=development

# API
API_PORT=3000
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:3001

# JWT (use a distinct, non-placeholder 32+ character value in production)
JWT_SECRET=change-me-in-dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=change-me-session-dev

# Email sign-in codes (set a distinct 32+ character EMAIL_CODE_SECRET in production)
# EMAIL_CODE_SECRET=
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_REQUEST_LIMIT=3
EMAIL_CODE_REQUEST_WINDOW_SECONDS=900
EMAIL_CODE_VERIFICATION_LIMIT=15
EMAIL_CODE_VERIFICATION_WINDOW_SECONDS=900

# Microsoft Azure AD / Entra ID SSO (optional; leave blank to disable)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URL=http://localhost:3000/api/auth/microsoft/callback

# Mail (dev uses Mailpit on :1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@abonten.local
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
SMTP_DELIVERY_TIMEOUT_MS=20000

# Web (Next.js) — NEXT_PUBLIC_* is exposed to the browser
WEB_PORT=3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Mobile (Expo)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# PostgreSQL + PostGIS
POSTGRES_USER=abonten
POSTGRES_PASSWORD=abonten
POSTGRES_DB=abonten
POSTGRES_PORT=5432
DATABASE_URL=postgresql://abonten:abonten@localhost:5432/abonten

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible object storage for dev)
MINIO_ROOT_USER=abonten
MINIO_ROOT_PASSWORD=abonten123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=abonten
S3_REGION=us-east-1

# Mailpit (email testing UI)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
